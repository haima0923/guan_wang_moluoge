# Copy to the project root as .env and protect it with chmod 600.
# On an EMPTY database, set a unique password of at least 16 characters.
# When migrating an existing database, its administrator password is retained.
ADMIN_PASSWORD=
# Optional: leave these empty when configuring Qwen through the admin interface.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=
