[Unit]
Description=Barsan Morocco freight website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=barsan-ma
Group=barsan-ma
WorkingDirectory=/srv/barsan-ma/current
ExecStart=/opt/barsan-ma/runtime/node-v24.22.1-linux-x64/bin/node server.mjs
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=DATA_DIR=/srv/barsan-ma/data
Environment=TRUST_PROXY=1
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/barsan-ma/data

[Install]
WantedBy=multi-user.target
