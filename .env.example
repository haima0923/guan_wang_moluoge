# This file is only an example. It is not loaded automatically.
# Node 24: node --env-file=.env server.mjs
HOST=127.0.0.1
PORT=3000
# Production must be behind an HTTPS reverse proxy.
# NODE_ENV=production
# ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters
# DATA_DIR=/var/lib/barsan

# Set to 1 only behind a trusted local reverse proxy; bind the backend to loopback.
TRUST_PROXY=0
